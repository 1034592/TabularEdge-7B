{"id": "h01", "file": "ledger.xlsx", "sheet": "流水", "text": "备注里括号那些去掉 顺便金额<0的标个红", "expect_amb": false, "steps": [{"op": "regex_replace", "args": {"col": "备注", "pattern": "[\\(（][^\\)）]*[\\)）]", "repl": ""}}, {"op": "conditional_format", "args": {"where": {"col": "金额", "cmp": "<", "value": 0}, "apply_to": "cell", "style": {"font_color": "FF0000"}}}]}
{"id": "h02", "file": "ledger.xlsx", "sheet": "流水", "text": "帮我按部门把金额加总一下 新建个表放", "expect_amb": false, "steps": [{"op": "group_aggregate", "args": {"by": ["部门"], "aggs": [{"col": "金额", "fn": "sum"}], "output_sheet": "按部门汇总", "mode": "formula"}}]}
{"id": "h03", "file": "ledger.xlsx", "sheet": "流水", "text": "金额从高到低排", "expect_amb": false, "steps": [{"op": "sort", "args": {"by": [{"col": "金额", "desc": true}]}}]}
{"id": "h04", "file": "ledger.xlsx", "sheet": "流水", "text": "把研发部的记录单独拎出来放一张表", "expect_amb": false, "steps": [{"op": "filter_to_sheet", "args": {"where": {"col": "部门", "cmp": "==", "value": "研发部"}, "output_sheet": "筛选_部门"}}]}
{"id": "h05", "file": "ledger.xlsx", "sheet": "流水", "text": "部门预算那张表里有负责人，按部门对过来，对不上的写“无”", "expect_amb": false, "steps": [{"op": "lookup_column", "args": {"name": "负责人", "key": "部门", "from_sheet": "部门预算", "from_key": "部门", "return": "负责人", "if_not_found": "无"}}]}
{"id": "h06", "file": "ledger.xlsx", "sheet": "流水", "text": "都有哪些部门？列个清单，每个部门几笔也数一下", "expect_amb": false, "steps": [{"op": "unique_to_sheet", "args": {"col": "部门", "output_sheet": "部门清单", "with_count": true}}]}
{"id": "h07", "file": "ledger.xlsx", "sheet": "流水", "text": "金额超过一万的整行标黄", "expect_amb": false, "steps": [{"op": "conditional_format", "args": {"where": {"col": "金额", "cmp": ">", "value": 10000}, "apply_to": "row", "style": {"fill_color": "FFFF00"}}}]}
{"id": "h08", "file": "ledger.xlsx", "sheet": "流水", "text": "删掉金额是负的那几行", "expect_amb": false, "steps": [{"op": "delete_rows", "args": {"where": {"col": "金额", "cmp": "<", "value": 0}}}]}
{"id": "h09", "file": "ledger.xlsx", "sheet": "流水", "text": "空着的备注填个“无”", "expect_amb": false, "steps": [{"op": "fill_empty", "args": {"col": "备注", "value": "无"}}]}
{"id": "h10", "file": "ledger.xlsx", "sheet": "流水", "text": "金额那列弄成千分位，两位小数", "expect_amb": false, "steps": [{"op": "number_format", "args": {"col": "金额", "format": "#,##0.00"}}]}
{"id": "h11", "file": "ledger.xlsx", "sheet": "流水", "text": "带括号的备注都删掉吧", "expect_amb": true, "steps": [{"op": "regex_replace", "args": {"col": "备注", "pattern": "[\\(（][^\\)）]*[\\)）]", "repl": ""}}]}
{"id": "h12", "file": "ledger.xlsx", "sheet": "流水", "text": "把负数金额标红，处理完存一下", "expect_amb": true, "steps": [{"op": "conditional_format", "args": {"where": {"col": "金额", "cmp": "<", "value": 0}, "apply_to": "cell", "style": {"font_color": "FF0000"}}}]}
{"id": "h13", "file": "ledger.xlsx", "sheet": "流水", "text": "加一列年份，取日期的年", "expect_amb": false, "steps": [{"op": "add_column", "args": {"name": "年份", "formula": "=YEAR([日期])"}}]}
{"id": "h14", "file": "ledger.xlsx", "sheet": "流水", "text": "加一列金额档位：金额>=5000算高，>=1000算中，其余算低", "expect_amb": false, "steps": [{"op": "add_column", "args": {"name": "金额档位", "formula": "=IFS([金额]>=5000,\"高\",[金额]>=1000,\"中\",TRUE,\"低\")"}}]}
{"id": "h15", "file": "ledger.xlsx", "sheet": "流水", "text": "sum 金额 by 部门 into a new sheet, 然后金额 desc 排一下", "expect_amb": false, "steps": [{"op": "sort", "args": {"by": [{"col": "金额", "desc": true}]}}, {"op": "group_aggregate", "args": {"by": ["部门"], "aggs": [{"col": "金额", "fn": "sum"}], "output_sheet": "按部门汇总", "mode": "formula"}}]}
{"id": "h16", "file": "ledger.xlsx", "sheet": "流水", "text": "按不门会总一下金鹅", "expect_amb": false, "steps": [{"op": "group_aggregate", "args": {"by": ["部门"], "aggs": [{"col": "金额", "fn": "sum"}], "output_sheet": "按部门汇总", "mode": "formula"}}]}
{"id": "h17", "file": "ledger.xlsx", "sheet": "流水", "text": "按金额jx排", "expect_amb": false, "steps": [{"op": "sort", "args": {"by": [{"col": "金额", "desc": true}]}}]}
{"id": "h18", "file": "ledger.xlsx", "sheet": "流水", "text": "完全一样的重复行删掉", "expect_amb": false, "steps": [{"op": "dedupe", "args": {}}]}
{"id": "h19", "file": "ledger.xlsx", "sheet": "流水", "text": "金额小于0的行直接删，然后覆盖原文件", "expect_amb": false, "steps": [{"op": "delete_rows", "args": {"where": {"col": "金额", "cmp": "<", "value": 0}}}, {"op": "save", "args": {"path": "ledger.xlsx"}}]}
{"id": "h20", "file": "ledger.xlsx", "sheet": "流水", "text": "把空的删掉", "expect_amb": true, "steps": [{"op": "delete_rows", "args": {"where": {"all": [{"col": "日期", "cmp": "is_empty"}, {"col": "部门", "cmp": "is_empty"}, {"col": "金额", "cmp": "is_empty"}, {"col": "备注", "cmp": "is_empty"}]}}}]}
{"id": "h21", "file": "sales.xlsx", "sheet": "Orders", "text": "add a Revenue column = Qty x Unit Price", "expect_amb": false, "steps": [{"op": "add_column", "args": {"name": "Revenue", "formula": "=[Qty]*[Unit Price]"}}]}
{"id": "h22", "file": "sales.xlsx", "sheet": "Orders", "text": "dedupe on order id pls", "expect_amb": false, "steps": [{"op": "dedupe", "args": {"cols": ["Order ID"]}}]}
{"id": "h23", "file": "sales.xlsx", "sheet": "Orders", "text": "pull Category from the Catalog tab by Product, N/A if missing", "expect_amb": false, "steps": [{"op": "lookup_column", "args": {"name": "Category", "key": "Product", "from_sheet": "Catalog", "from_key": "Product", "return": "Category", "if_not_found": "N/A"}}]}
{"id": "h24", "file": "sales.xlsx", "sheet": "Orders", "text": "filter rows w/ qty over 10 to a new sheet", "expect_amb": false, "steps": [{"op": "filter_to_sheet", "args": {"where": {"col": "Qty", "cmp": ">", "value": 10}, "output_sheet": "Filtered Qty"}}]}
{"id": "h25", "file": "sales.xlsx", "sheet": "Orders", "text": "each region its own file", "expect_amb": false, "steps": [{"op": "split_to_files", "args": {"by": "Region", "path_template": "拆分_Region/{value}.xlsx"}}]}
{"id": "h26", "file": "sales.xlsx", "sheet": "Orders", "text": "total qty per sales rep", "expect_amb": false, "steps": [{"op": "group_aggregate", "args": {"by": ["Sales Rep"], "aggs": [{"col": "Qty", "fn": "sum"}], "output_sheet": "Sales Rep summary", "mode": "formula"}}]}
{"id": "h27", "file": "sales.xlsx", "sheet": "Orders", "text": "remove the bracket stuff from remarks and trim the spaces there too", "expect_amb": false, "steps": [{"op": "regex_replace", "args": {"col": "Remarks", "pattern": "[\\(（][^\\)）]*[\\)）]", "repl": ""}}, {"op": "trim", "args": {"cols": ["Remarks"]}}]}
{"id": "h28", "file": "sales.xlsx", "sheet": "Orders", "text": "get rid of duplicate orders", "expect_amb": true, "steps": [{"op": "dedupe", "args": {"cols": ["Order ID"]}}]}
{"id": "h29", "file": "sales.xlsx", "sheet": "Orders", "text": "delete the empty ones", "expect_amb": true, "steps": [{"op": "delete_rows", "args": {"where": {"all": [{"col": "Order ID", "cmp": "is_empty"}, {"col": "Sales Rep", "cmp": "is_empty"}, {"col": "Region", "cmp": "is_empty"}, {"col": "Product", "cmp": "is_empty"}, {"col": "Qty", "cmp": "is_empty"}, {"col": "Unit Price", "cmp": "is_empty"}, {"col": "Remarks", "cmp": "is_empty"}]}}}]}
{"id": "h30", "file": "sales.xlsx", "sheet": "Orders", "text": "unit price above 5000 in red, and sort by region", "expect_amb": false, "steps": [{"op": "sort", "args": {"by": [{"col": "Region", "desc": false}]}}, {"op": "conditional_format", "args": {"where": {"col": "Unit Price", "cmp": ">", "value": 5000}, "apply_to": "cell", "style": {"font_color": "FF0000"}}}]}
{"id": "h31", "file": "sales.xlsx", "sheet": "Orders", "text": "list unique products with counts", "expect_amb": false, "steps": [{"op": "unique_to_sheet", "args": {"col": "Product", "output_sheet": "Product list", "with_count": true}}]}
{"id": "h32", "file": "sales.xlsx", "sheet": "Orders", "text": "hihglight negatve qty in red", "expect_amb": false, "steps": [{"op": "conditional_format", "args": {"where": {"col": "Qty", "cmp": "<", "value": 0}, "apply_to": "cell", "style": {"font_color": "FF0000"}}}]}
{"id": "h33", "file": "sales.xlsx", "sheet": "Orders", "text": "按单价降序排个序，弄完保存下", "expect_amb": true, "steps": [{"op": "sort", "args": {"by": [{"col": "Unit Price", "desc": true}]}}]}
{"id": "h34", "file": "sales.xlsx", "sheet": "Orders", "text": "按区域把数量合计一下，再按产品从Catalog把List Price查过来，查不到写0", "expect_amb": false, "steps": [{"op": "lookup_column", "args": {"name": "List Price", "key": "Product", "from_sheet": "Catalog", "from_key": "Product", "return": "List Price", "if_not_found": "0"}}, {"op": "group_aggregate", "args": {"by": ["Region"], "aggs": [{"col": "Qty", "fn": "sum"}], "output_sheet": "按Region汇总", "mode": "formula"}}]}
